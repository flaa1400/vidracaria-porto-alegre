---
import SEO from '../components/SEO.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import { SITE_CONFIG } from '../data/config';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Gerenciador de SEO Dinâmico -->
		<SEO title={title} description={description} />
		
		<!-- Structured Data (JSON-LD) para SEO Local -->
		<SchemaLocalBusiness />
		
		<!-- Google Fonts - Inter (Acessibilidade) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"></noscript>
	</head>
	<body class="font-sans antialiased bg-[#F0F4F8] text-secondary min-h-screen flex flex-col">
		
		<!-- Header: Sticky (fixo) com leve desfoque de fundo (backdrop-blur) -->
		<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/60 py-2">
			<div class="container mx-auto px-6 md:px-12 flex justify-between items-center">
				<a href="/" class="hover:scale-105 active:scale-95 transition-all inline-block">
					<img src="/logo.png" alt="Vidros Pro" class="h-20 md:h-24 w-auto object-contain" />
				</a>
				
				<!-- Desktop Navigation -->
				<nav class="hidden md:flex space-x-8 text-secondary font-bold items-center">
					<a href="/" class="hover:text-primary hover:scale-105 active:scale-95 transition-all inline-block">Home</a>
					<a href="/servicos" class="hover:text-primary hover:scale-105 active:scale-95 transition-all inline-block">Serviços</a>
					<a href="/sobre" class="hover:text-primary hover:scale-105 active:scale-95 transition-all inline-block">Sobre Nós</a>
					<a href="/contato" class="hover:text-primary hover:scale-105 active:scale-95 transition-all inline-block">Contato</a>
				</nav>
				
				<!-- Desktop CTA -->
				<div class="hidden md:block">
					<a href="/contato" class="bg-secondary text-white px-6 py-3 rounded-lg font-bold hover:scale-105 active:scale-95 transition-all text-sm shadow-md hover:shadow-secondary/20 inline-block">
						Orçamento Rápido
					</a>
				</div>

				<!-- Mobile Menu Button (Hamburger) -->
				<button id="menu-btn" class="block md:hidden text-secondary hover:text-primary focus:outline-none hover:scale-105 active:scale-95 transition-all p-2" aria-label="Abrir menu">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>
			</div>
		</header>

		<!-- Mobile Menu Drawer (Opaque bg-accent with backdrop-blur, absolute z-999) -->
		<div id="mobile-menu" class="fixed inset-0 z-[999] bg-accent/95 backdrop-blur-xl hidden flex-col justify-between p-8">
			<!-- Drawer Header -->
			<div class="flex justify-between items-center w-full">
				<a href="/" class="hover:scale-105 active:scale-95 transition-all inline-block bg-white p-2 rounded-xl">
					<img src="/logo.png" alt="Vidros Pro" class="h-16 w-auto object-contain" />
				</a>
				<button id="menu-close-btn" class="text-white hover:text-primary hover:scale-105 active:scale-95 transition-all focus:outline-none p-2" aria-label="Fechar menu">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
			
			<!-- Giant Centralized Links (Títulos e links no fundo escuro DEVEM ser text-primary) -->
			<nav class="flex flex-col items-center justify-center space-y-8 my-auto text-center">
				<a href="/" class="text-3xl font-extrabold text-primary hover:text-white hover:scale-110 active:scale-95 transition-all">Home</a>
				<a href="/servicos" class="text-3xl font-extrabold text-primary hover:text-white hover:scale-110 active:scale-95 transition-all">Serviços</a>
				<a href="/sobre" class="text-3xl font-extrabold text-primary hover:text-white hover:scale-110 active:scale-95 transition-all">Sobre Nós</a>
				<a href="/contato" class="text-3xl font-extrabold text-primary hover:text-white hover:scale-110 active:scale-95 transition-all">Contato</a>
			</nav>
			
			<!-- WhatsApp CTA -->
			<div class="w-full flex justify-center pb-8">
				<a href={`https://wa.me/${SITE_CONFIG.whatsappRaw}?text=Ol%C3%A1%20vim%20do%20site%2C%20Vidros%20Pro%20e%20gostaria%20de%20fazer%20um%20Or%C3%A7amento`} target="_blank" rel="noopener noreferrer" class="w-full max-w-sm text-center bg-green-500 text-white font-extrabold py-4 px-8 rounded-xl shadow-xl shadow-green-500/20 hover:bg-green-600 hover:scale-105 active:scale-95 transition-all flex items-center justify-center space-x-2">
					<svg class="h-6 w-6 fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
						<path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
					</svg>
					<span>Chamar no WhatsApp</span>
				</a>
			</div>
		</div>

		<main class="flex-grow">
			<slot />
		</main>

		<!-- Footer: Fundo escuro (bg-secondary = Slate-900), texto de corpo DEVE ser text-white ou text-gray-100, títulos e links DEVEM ser text-primary (Sky-400) -->
		<footer class="pt-24 pb-12 bg-secondary text-gray-100 border-t border-slate-800">
			<div class="container mx-auto px-6 md:px-12">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12 border-b border-slate-800 pb-12">
					<div>
						<!-- Títulos em fundo escuro DEVEM ser text-primary -->
						<div class="mb-6">
							<a href="/" class="hover:scale-105 active:scale-95 transition-all inline-block bg-white p-2.5 rounded-xl">
								<img src="/logo.png" alt="Vidros Pro" class="h-20 w-auto object-contain" />
							</a>
						</div>
						<p class="text-gray-100 text-sm leading-relaxed mb-6">
							Serviços profissionais e sob medida com atendimento em {SITE_CONFIG.address.city} e Região Metropolitana.
						</p>
						<div class="flex items-center space-x-4">
							<a 
								href={SITE_CONFIG.social.instagram} 
								target="_blank" 
								rel="noopener noreferrer" 
								class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-800/50 hover:bg-primary/20 text-slate-400 hover:text-primary border border-slate-800 hover:border-primary/50 transition-all duration-300 transform hover:-translate-y-1 active:scale-95 shadow-md hover:shadow-primary/10"
								aria-label="Instagram"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
								</svg>
							</a>
							<a 
								href={SITE_CONFIG.social.facebook} 
								target="_blank" 
								rel="noopener noreferrer" 
								class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-800/50 hover:bg-primary/20 text-slate-400 hover:text-primary border border-slate-800 hover:border-primary/50 transition-all duration-300 transform hover:-translate-y-1 active:scale-95 shadow-md hover:shadow-primary/10"
								aria-label="Facebook"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
								</svg>
							</a>
						</div>
					</div>
					<div>
						<h3 class="text-lg font-black text-primary tracking-tight mb-6">Links Úteis</h3>
						<ul class="space-y-3 text-sm">
							<!-- Links em fundo escuro DEVEM ser text-primary e ter micro-interações -->
							<li><a href="/" class="text-primary hover:text-white hover:scale-105 active:scale-95 transition-all inline-block font-semibold">Home</a></li>
							<li><a href="/servicos" class="text-primary hover:text-white hover:scale-105 active:scale-95 transition-all inline-block font-semibold">Nossos Serviços</a></li>
							<li><a href="/sobre" class="text-primary hover:text-white hover:scale-105 active:scale-95 transition-all inline-block font-semibold">Sobre Nós</a></li>
							<li><a href="/contato" class="text-primary hover:text-white hover:scale-105 active:scale-95 transition-all inline-block font-semibold">Fale Conosco</a></li>
							<li><a href="/privacidade" class="text-primary hover:text-white hover:scale-105 active:scale-95 transition-all inline-block font-semibold">Política de Privacidade</a></li>
							<li><a href="/termos" class="text-primary hover:text-white hover:scale-105 active:scale-95 transition-all inline-block font-semibold">Termos de Uso</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-lg font-black text-primary tracking-tight mb-6">Contato</h3>
						<p class="text-gray-100 text-sm leading-relaxed space-y-2">
							<span class="block">{SITE_CONFIG.address.city} - {SITE_CONFIG.address.state}</span>
							<span class="block">WhatsApp: <a href={`https://wa.me/${SITE_CONFIG.whatsappRaw}?text=Ol%C3%A1%20vim%20do%20site%2C%20Vidros%20Pro%20e%20gostaria%20de%20fazer%20um%20Or%C3%A7amento`} target="_blank" rel="noopener noreferrer" class="text-primary hover:text-white hover:scale-105 active:scale-95 transition-all inline-block font-semibold underline">{SITE_CONFIG.whatsapp}</a></span>
							<span class="block">E-mail: <span class="text-primary font-semibold">{SITE_CONFIG.email}</span></span>
						</p>
					</div>
				</div>
				<div class="text-center pt-8 text-xs text-slate-500 font-semibold">
					&copy; {new Date().getFullYear()} {SITE_CONFIG.name}. Todos os direitos reservados.
				</div>
			</div>
		</footer>

		<!-- Botão Flutuante Conversão Premium -->
		<WhatsAppBtn />

		<!-- JavaScript do Menu Mobile Indestrutível com Trava de Scroll -->
		<script>
			const menuBtn = document.getElementById('menu-btn');
			const menuCloseBtn = document.getElementById('menu-close-btn');
			const mobileMenu = document.getElementById('mobile-menu');

			function openMenu() {
				if (mobileMenu) {
					mobileMenu.classList.remove('hidden');
					mobileMenu.classList.add('flex');
					document.body.style.overflow = 'hidden';
				}
			}

			function closeMenu() {
				if (mobileMenu) {
					mobileMenu.classList.add('hidden');
					mobileMenu.classList.remove('flex');
					document.body.style.overflow = '';
				}
			}

			menuBtn?.addEventListener('click', openMenu);
			menuCloseBtn?.addEventListener('click', closeMenu);

			// Fechar o menu quando clicar em qualquer link
			const mobileLinks = mobileMenu?.querySelectorAll('a');
			mobileLinks?.forEach(link => {
				link.addEventListener('click', closeMenu);
			});
		</script>
	</body>
</html>

<style is:global>
	/* Definição de respiro para seções principais */
	section {
		@apply py-24 md:py-32;
	}
</style>
