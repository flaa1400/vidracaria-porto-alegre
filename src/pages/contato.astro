---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/config';
---

<Layout title="Contato | Vidraçaria em Porto Alegre">
	<section class="bg-white">
		<div class="container mx-auto px-6 md:px-12">
			<!-- H1 com escala controlada e tracking-tighter -->
			<h1 class="text-4xl md:text-5xl font-black text-gray-900 leading-tight tracking-tighter mb-16">
				Fale Conosco
			</h1>

			<!-- Grid com gap-10 -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
				
				<!-- Formulário Funcional e com Design Limpo (p-10), com animação de hover sutil -->
				<div class="bg-slate-50 border border-slate-100 rounded-2xl p-10 shadow-sm hover:shadow-md transition-shadow duration-300">
					<h2 class="text-2xl font-black text-gray-900 tracking-tighter leading-tight mb-6">Solicite um Orçamento</h2>
					
					<!-- Alertas de Feedback -->
					<div id="success-alert" class="hidden bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 p-6 rounded-xl mb-6">
						<div class="flex items-start space-x-3">
							<svg class="h-6 w-6 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							<div>
								<h3 class="font-black text-emerald-950">Orçamento Solicitado!</h3>
								<p class="text-sm text-emerald-800/90 mt-1">Sua mensagem foi enviada com sucesso. Nossa equipe entrará em contato em breve pelo e-mail informado.</p>
							</div>
						</div>
					</div>

					<div id="error-alert" class="hidden bg-rose-500/10 border border-rose-500/30 text-rose-800 p-6 rounded-xl mb-6">
						<div class="flex items-start space-x-3">
							<svg class="h-6 w-6 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
							</svg>
							<div>
								<h3 class="font-black text-rose-950">Erro ao enviar mensagem</h3>
								<p class="text-sm text-rose-800/90 mt-1">Por favor, verifique sua conexão ou fale diretamente conosco pelo nosso canal de WhatsApp.</p>
							</div>
						</div>
					</div>

					<form class="space-y-6" id="contact-form" data-email={SITE_CONFIG.email}>
						<!-- Campos Anti-Spam e Captcha do FormSubmit -->
						<input type="text" name="_honey" style="display:none" />
						<input type="hidden" name="_captcha" value="false" />
						
						<div>
							<label for="name" class="block text-sm font-bold text-gray-900 mb-2">Nome Completo</label>
							<input type="text" id="name" name="name" class="w-full p-4 border border-slate-200 rounded-lg focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary bg-white text-gray-900 font-medium" placeholder="Seu nome" required />
						</div>
						<div>
							<label for="email" class="block text-sm font-bold text-gray-900 mb-2">E-mail</label>
							<input type="email" id="email" name="email" class="w-full p-4 border border-slate-200 rounded-lg focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary bg-white text-gray-900 font-medium" placeholder="seuemail@exemplo.com" required />
						</div>
						<div>
							<label for="message" class="block text-sm font-bold text-gray-900 mb-2">Especificações do Projeto</label>
							<textarea id="message" name="message" rows="4" class="w-full p-4 border border-slate-200 rounded-lg focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary bg-white text-gray-900 font-medium" placeholder="Descreva as medidas, tipo de vidro e local da instalação..." required></textarea>
						</div>
						<!-- Botão de contato com padding grande e micro-interação scale -->
						<button type="submit" class="w-full bg-secondary text-white font-extrabold p-6 rounded-lg hover:scale-105 active:scale-95 transition-all duration-300 text-center shadow-lg shadow-secondary/15 hover:bg-blue-900 cursor-pointer">
							Enviar Mensagem
						</button>
					</form>
				</div>

				<!-- NAP (Nome, Endereço, Telefone) + WhatsApp -->
				<div class="bg-slate-50 border border-slate-100 rounded-2xl p-10 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow duration-300">
					<div>
						<h2 class="text-2xl font-black text-gray-900 tracking-tighter leading-tight mb-8">Informações de Contato</h2>
						
						<!-- Estrutura NAP (Nome / Endereço / Tel) -->
						<div class="space-y-8 mb-10 text-lg">
							<div>
								<span class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Nome Fantasia</span>
								<p class="font-extrabold text-gray-900">{SITE_CONFIG.corporateName}</p>
							</div>
							
							<div>
								<span class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Endereço Comercial</span>
								<p class="font-bold text-gray-900">{SITE_CONFIG.address.street} - {SITE_CONFIG.address.neighborhood}, {SITE_CONFIG.address.city} - {SITE_CONFIG.address.state}, {SITE_CONFIG.address.postalCode}</p>
							</div>

							<div>
								<span class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">WhatsApp / E-mail</span>
								<p class="font-bold text-gray-900">WhatsApp: <a href={`https://wa.me/${SITE_CONFIG.whatsappRaw}?text=Ol%C3%A1%2C%20gostaria%20de%20fazer%20um%20or%C3%A7amento`} target="_blank" rel="noopener noreferrer" class="hover:text-secondary hover:underline transition-colors">{SITE_CONFIG.whatsapp}</a></p>
								<p class="font-bold text-gray-900">E-mail: <span class="font-semibold text-gray-900">{SITE_CONFIG.email}</span></p>
							</div>
						</div>
					</div>

					<!-- Botão de WhatsApp com padding p-8 e micro-interações -->
					<a href={`https://wa.me/${SITE_CONFIG.whatsappRaw}?text=Ol%C3%A1%20vim%20do%20site%2C%20Vidros%20Pro%20e%20gostaria%20de%20fazer%20um%20Or%C3%A7amento`} target="_blank" rel="noopener noreferrer" class="block w-full bg-emerald-600 text-white text-center font-extrabold p-8 rounded-lg hover:scale-105 active:scale-95 transition-all duration-300 shadow-lg shadow-emerald-500/10 hover:bg-emerald-700 flex items-center justify-center space-x-2">
						<svg class="h-6 w-6 fill-current inline-block" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
							<path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
						</svg>
						<span>Chamar no WhatsApp</span>
					</a>
				</div>

			</div>

			<!-- Grid de Informações Adicionais (Horário e Regiões) -->
			<div class="mt-20 grid grid-cols-1 md:grid-cols-2 gap-10 border-t border-slate-100 pt-16">
				<!-- Horários & Cobertura -->
				<div class="bg-slate-50 border border-slate-100 rounded-2xl p-10 shadow-sm hover:shadow-md transition-shadow duration-300">
					<h3 class="text-2xl font-black text-gray-900 tracking-tighter leading-tight mb-6">Horário de Atendimento</h3>
					
					<div class="space-y-6">
						<div>
							<span class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Horários de Funcionamento</span>
							<p class="font-bold text-gray-900">Segunda a Sexta: <span class="font-normal text-gray-600">08:00 às 18:00</span></p>
							<p class="font-bold text-gray-900">Sábado: <span class="font-normal text-gray-600">08:00 às 12:00</span></p>
							<p class="font-bold text-gray-900">Domingo e Feriados: <span class="font-normal text-gray-600">Fechado</span></p>
						</div>


						<div>
							<span class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Agendamento de Visitas</span>
							<p class="text-gray-600 text-sm leading-relaxed font-medium">
								As visitas técnicas para medições construtivas e apresentação de amostras de vidros/perfis ocorrem de segunda a sexta-feira, em horários pré-agendados com o cliente de acordo com a disponibilidade da nossa equipe de engenharia e instalação.
							</p>
						</div>

					</div>
				</div>

				<!-- FAQ rápido -->
				<div class="bg-slate-50 border border-slate-100 rounded-2xl p-10 shadow-sm hover:shadow-md transition-shadow duration-300">
					<h3 class="text-2xl font-black text-gray-900 tracking-tighter leading-tight mb-6">Dúvidas Frequentes</h3>
					
					<div class="space-y-6">
						<div>
							<h4 class="font-bold text-gray-900 mb-1">Qual o prazo médio de resposta para orçamentos?</h4>
							<p class="text-gray-600 text-sm font-medium">Nossa equipe comercial costuma responder a contatos via WhatsApp em até 2 horas úteis. Para mensagens enviadas fora do horário comercial, retornamos logo na primeira hora do dia útil seguinte.</p>
						</div>
						<div>
							<h4 class="font-bold text-gray-900 mb-1">Vocês realizam visita técnica para medição?</h4>
							<p class="text-gray-600 text-sm font-medium">Sim! A visita para medição final e alinhamento dos detalhes construtivos é recomendada e pode ser agendada sem custo adicional para Porto Alegre após aprovação do orçamento inicial estimativo.</p>
						</div>

					</div>
				</div>
			</div>

		</div>
	</section>

	<script is:inline>
		const contactForm = document.getElementById('contact-form');
		const successAlert = document.getElementById('success-alert');
		const errorAlert = document.getElementById('error-alert');

		contactForm?.addEventListener('submit', async (e) => {
			e.preventDefault();
			
			const submitBtn = contactForm.querySelector('button[type="submit"]');
			if (!submitBtn) return;

			const originalText = submitBtn.innerHTML;
			submitBtn.disabled = true;
			submitBtn.innerHTML = `
				<svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
				Enviando...
			`;

			successAlert?.classList.add('hidden');
			errorAlert?.classList.add('hidden');

			const formData = new FormData(contactForm);
			const data = Object.fromEntries(formData.entries());
			const destEmail = contactForm.dataset.email;

			try {
				const response = await fetch(`https://formsubmit.co/ajax/${destEmail}`, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'Accept': 'application/json'
					},
					body: JSON.stringify(data)
				});

				const result = await response.json();

				if (response.ok && result.success === 'true') {
					successAlert?.classList.remove('hidden');
					contactForm.reset();
					// Scroll suave até o alerta de sucesso
					successAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
				} else {
					errorAlert?.classList.remove('hidden');
					errorAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
			} catch (err) {
				console.error('Error submitting form:', err);
				errorAlert?.classList.remove('hidden');
				errorAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
			} finally {
				submitBtn.disabled = false;
				submitBtn.innerHTML = originalText;
			}
		});
	</script>
</Layout>
