---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ServiceIcon from '../../components/ServiceIcon.astro';

const servicos = await getCollection('servicos');

const serviceImages: Record<string, string> = {
  'box-de-vidro-para-banheiro': '/box-banheiro-home.jpg',
  'cobertura-de-vidro': '/cobertura-real-1.jpg',
  'conserto-de-box-de-banheiro': '/box-banheiro-real-2.jpg',
  'cortina-de-vidro': '/sacada-real-1.jpg',
  'divisorias-de-vidro': '/divisoria-real-1.jpg',
  'envidracamento-de-sacada': '/sacada-real-2.jpg',
  'espelho-sob-medida': '/espelho-real-1.jpg',
  'fechamento-de-varanda-com-vidro': '/sacada-real-2.jpg',
  'guarda-corpo-de-vidro': '/guardacorpo-real-1.jpg',
  'manutencao-de-cortina-de-vidro': '/manutencao-real-1.jpg',
  'manutencao-em-esquadrias-de-aluminio': '/manutencao-esquadria-1.jpg',
  'manutencao-em-sacadas-de-vidro': '/manutencao-sacada-1.jpg',
  'muro-de-vidro': '/muro-real-1.jpg',
  'porta-de-vidro-temperado': '/porta-real-1.jpg',
  'vidros-sob-medida': '/vidrossobmedida-real-1.jpg',
};
---

<Layout title="Nossos Serviços | Vidraçaria em Porto Alegre">
	<section class="bg-white">
		<div class="container mx-auto px-6 md:px-12">
			<!-- H1 com escala controlada e tracking-tighter -->
			<h1 class="text-4xl md:text-5xl font-black text-gray-900 leading-tight tracking-tighter mb-16">
				Nossos Serviços
			</h1>

			<!-- Grid de Serviços com gap-10 -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-10">
				{servicos.map((servico) => {
					const imageUrl = serviceImages[servico.slug] || '/glazier_workshop_bg.jpg';
					return (
						<!-- Card com imagens, preenchimento otimizado e micro-interações de escala/sombra -->
						<div class="group bg-slate-50 border border-slate-100 rounded-2xl overflow-hidden flex flex-col justify-between shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-secondary/5">
							<div>
								<!-- Imagem do Serviço -->
								<div class="relative h-48 overflow-hidden">
									<img 
										src={imageUrl} 
										alt={servico.data.title} 
										class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
										loading="lazy"
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
								</div>

								<div class="p-8">
									<h2 class="text-xl font-bold text-gray-900 mb-4">
										{servico.data.title}
									</h2>
									<p class="text-gray-600 leading-relaxed text-sm">
										{servico.data.description}
									</p>
								</div>
							</div>
							<div class="px-8 pb-8">
								<a href={`/servicos/${servico.slug}`} class="text-secondary font-bold hover:text-blue-700 hover:scale-105 active:scale-95 transition-all duration-300 inline-flex items-center gap-2 text-sm">
									Saiba Mais &rarr;
								</a>
							</div>
						</div>
					);
				})}
			</div>
		</div>
	</section>
</Layout>
