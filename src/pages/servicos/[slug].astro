const details = serviceDataMap[entry.slug] || { specs: [], benefits: [] };
---

<Layout title={`${entry.data.title} | Vidraçaria em Porto Alegre`}>
	
	<!-- Hero do Serviço -->
	<section class="bg-white border-b border-slate-200/50 py-24">
		<div class="max-w-5xl mx-auto px-6">
			<!-- Tag -->
			<span class="inline-block bg-primary/10 text-primary text-xs font-black tracking-widest uppercase px-4 py-2 rounded-full mb-6">
				Serviço Especializado
			</span>
			
			<!-- H1 com escala controlada e tracking-tighter -->
			<h1 class="text-4xl md:text-5xl font-black text-secondary leading-tight tracking-tighter mb-16">
				{entry.data.title}
			</h1>
			
			<p class="text-xl text-slate-600 leading-relaxed max-w-3xl font-medium">
				{entry.data.description}
			</p>
		</div>
	</section>

	<!-- Detalhes do Serviço: Especificações Técnicas + Benefícios -->
	<section class="bg-slate-100/30">
		<div class="max-w-5xl mx-auto px-6">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
				
				<!-- Seção de Especificações Técnicas (p-10) com micro-interações -->
				<div class="bg-white border border-slate-200/60 rounded-2xl p-10 shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-secondary/5">
					<h2 class="text-2xl font-black text-secondary tracking-tighter leading-tight mb-6">Especificações Técnicas</h2>
					<ul class="space-y-4">
						{details.specs.map(spec => (
							<li class="flex items-start gap-3 text-slate-600 text-base">
								<span class="text-primary text-lg mt-0.5">✔</span>
								<span class="font-medium">{spec}</span>
							</li>
						))}
					</ul>
				</div>

				<!-- Benefícios/Aplicações (p-10) com micro-interações -->
				<div class="bg-white border border-slate-200/60 rounded-2xl p-10 shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-primary/5">
					<h2 class="text-2xl font-black text-secondary tracking-tighter leading-tight mb-6">Benefícios & Aplicações</h2>
					<ul class="space-y-4">
						{details.benefits.map(benefit => (
							<li class="flex items-start gap-3 text-slate-600 text-base">
								<span class="text-primary text-lg mt-0.5">★</span>
								<span class="font-medium">{benefit}</span>
							</li>
						))}
					</ul>
				</div>

			</div>

			<!-- Conteúdo Markdown Principal -->
			<div class="border-t border-slate-200/60 pt-16 bg-white p-10 rounded-2xl shadow-sm border">
				<h2 class="text-2xl font-black text-secondary tracking-tighter leading-tight mb-8">Informações Detalhadas</h2>
				<article class="prose prose-lg max-w-none text-slate-600 prose-headings:text-secondary prose-headings:font-bold prose-headings:tracking-tighter prose-headings:leading-tight prose-p:leading-relaxed">
					<Content />
				</article>
			</div>
		</div>
	</section>

	<!-- CTA de Fechamento: Fundo escuro (bg-secondary = Slate-900). Corpo deve ser text-white. Título deve ser text-primary (Sky-400). -->
	<section class="bg-secondary text-white">
		<div class="max-w-5xl mx-auto px-6 text-center">
			<h2 class="text-3xl md:text-4xl font-black text-primary tracking-tighter leading-tight mb-6">Fale com um Especialista Agora</h2>
			<!-- Texto de corpo em fundo escuro DEVE ser text-white -->
			<p class="text-lg text-white max-w-xl mx-auto mb-10">
				Solicite um orçamento sob medida ou agende uma medição técnica em seu local com nosso time.
			</p>
			<!-- Dois botões grandes com micro-interações -->
			<div class="flex flex-wrap justify-center gap-6">
				<a href={`https://wa.me/${SITE_CONFIG.whatsappRaw}?text=Ol%C3%A1%20vim%20do%20site%2C%20Vidros%20Pro%20e%20gostaria%20de%20fazer%20um%20Or%C3%A7amento`} target="_blank" rel="noopener noreferrer" class="bg-primary text-accent hover:scale-105 active:scale-95 transition-all duration-300 font-extrabold px-8 py-4 rounded-lg shadow-lg shadow-primary/20 hover:bg-sky-300 flex items-center justify-center">
					Solicitar via WhatsApp
				</a>
				<a href={`tel:${SITE_CONFIG.phoneRaw}`} class="bg-white text-secondary hover:scale-105 active:scale-95 transition-all duration-300 font-extrabold px-8 py-4 rounded-lg shadow-lg shadow-white/10 hover:bg-slate-100 flex items-center justify-center">
					Ligar para {SITE_CONFIG.phone}
				</a>
			</div>
		</div>
	</section>

</Layout>
