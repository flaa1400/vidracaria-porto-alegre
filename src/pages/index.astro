---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../data/config';
import ServiceIcon from '../components/ServiceIcon.astro';

const allServices = await getCollection('servicos');
// Exibir até 6 serviços na página inicial
const services = allServices.slice(0, 6);

const serviceImages: Record<string, string> = {
  'box-de-vidro-para-banheiro': '/box-banheiro-home.jpg',
  'cobertura-de-vidro': '/cobertura-real-1.jpg',
  'conserto-de-box-de-banheiro': '/box-banheiro-real-2.jpg',
  'cortina-de-vidro': '/sacada-real-1.jpg',
  'divisorias-de-vidro': '/divisoria-real-1.jpg',
  'envidracamento-de-sacada': '/sacada-real-2.jpg',
  'espelho-sob-medida': '/espelho-real-1.jpg',
  'fechamento-de-varanda-com-vidro': '/sacada-real-2.jpg',
  'guarda-corpo-de-vidro': '/guardacorpo-real-1.jpg',
  'manutencao-de-cortina-de-vidro': '/manutencao-real-1.jpg',
  'manutencao-em-esquadrias-de-aluminio': '/manutencao-esquadria-1.jpg',
  'manutencao-em-sacadas-de-vidro': '/manutencao-sacada-1.jpg',
  'muro-de-vidro': '/muro-real-1.jpg',
  'porta-de-vidro-temperado': '/porta-real-1.jpg',
  'vidros-sob-medida': '/vidrossobmedida-real-1.jpg',
};
---

<Layout 
	title="Vidraçaria em Porto Alegre | Projetos e Vidros sob Medida"
	description="A melhor Vidraçaria em Porto Alegre para o seu projeto. Encontre vidros em Porto alegre de alta qualidade na nossa vidracaria. Acesse e ligue para o nosso telefone de vidraçaria perto de mim!"
>
	
	<!-- 1. Hero Section -->
	<section class="relative bg-secondary overflow-hidden py-24 md:py-32">
		<!-- Imagem de fundo com opacidade reduzida e degradê suave para preservar contraste e legibilidade -->
		<div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-[0.12]" style="background-image: url('/glazier_workshop_bg.jpg');"></div>
		<div class="absolute inset-0 bg-gradient-to-r from-secondary via-secondary/80 to-transparent"></div>

		<div class="relative container mx-auto px-6 md:px-12 z-10">
			<!-- Tag -->
			<span class="inline-block bg-primary text-accent text-xs font-black tracking-widest uppercase px-4 py-2 rounded-full mb-6 animate-pulse">
				Líder em Vidros sob Medida
			</span>
			
			<!-- Título (H1) com leading-tight, tracking-tighter e escala desktop de no máximo 6xl -->
			<h1 class="text-4xl md:text-6xl font-black text-white leading-tight tracking-tighter mb-8">
				Vidraçaria em <span class="text-primary">Porto Alegre</span>
			</h1>

			<!-- Subtítulo persuasivo contendo as primeiras 100-150 palavras com palavras-chave -->
			<p class="text-lg md:text-xl text-slate-300 max-w-2xl leading-relaxed mb-12">
				Procurando por <strong>vidros em Porto alegre</strong> ou uma <strong>vidraçaria perto de mim</strong> com atendimento rápido? A nossa <strong>vidraçaria</strong> realiza projetos sob medida em vidros temperados, espelhos e box de banheiro. Se você busca o <strong>telefone de vidraçaria</strong> confiável para solicitar um orçamento ou uma <strong>vidracaria</strong> parceira para seu projeto, fale conosco agora!
			</p>

			<!-- Dois botões com os textos exatos pedidos, micro-interações hover:scale-105 active:scale-95 -->
			<div class="flex flex-wrap gap-4">
				<a href={`https://wa.me/${SITE_CONFIG.whatsappRaw}?text=Ol%C3%A1%20vim%20do%20site%2C%20Vidros%20Pro%20e%20gostaria%20de%20fazer%20um%20Or%C3%A7amento`} target="_blank" rel="noopener noreferrer" class="bg-primary text-accent hover:scale-105 active:scale-95 transition-all duration-300 font-extrabold px-8 py-4 rounded-lg shadow-lg shadow-primary/10 hover:bg-sky-300 inline-block">
					Solicitar Orçamento no WhatsApp
				</a>
				<a href="/servicos" class="bg-white/10 text-white border border-white/20 hover:scale-105 active:scale-95 transition-all duration-300 font-extrabold px-8 py-4 rounded-lg hover:bg-white/20 inline-block">
					Ver Nossos Serviços
				</a>
			</div>
		</div>
	</section>

	<!-- 2. Diferenciais Section -->
	<section class="bg-slate-100/50 border-t border-slate-200/50">
		<div class="container mx-auto px-6 md:px-12">
			<div class="mb-16">
				<h2 class="text-3xl md:text-4xl font-black text-secondary tracking-tighter leading-tight mb-4">Por que escolher a nossa Vidraçaria em Porto Alegre?</h2>
				<p class="text-lg text-slate-600">Diferenciais que nos destacam como referência na região de {SITE_CONFIG.address.city}.</p>
			</div>

			<!-- Grid com 4 cards interativos com hover:scale-105 active:scale-95 -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="bg-white border border-slate-100 rounded-2xl p-8 shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-secondary/5 flex flex-col justify-between">
					<div>
						<div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 shadow-sm text-primary">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="10" x2="14" y1="2" y2="2"/>
								<line x1="12" x2="12" y1="14" y2="11"/>
								<circle cx="12" cy="14" r="8"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-secondary mb-4">Vidros em Porto alegre com Instalação Rápida</h3>
						<p class="text-slate-600 leading-relaxed text-sm">
							Agilidade e compromisso com o seu tempo. Realizamos a montagem do seu box ou espelho com processos otimizados para garantir rapidez e limpeza pós-obra.
						</p>
					</div>
				</div>

				<div class="bg-white border border-slate-100 rounded-2xl p-8 shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-secondary/5 flex flex-col justify-between">
					<div>
						<div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 shadow-sm text-primary">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
								<path d="m9 11 2 2 4-4"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-secondary mb-4">Padrão ABNT</h3>
						<p class="text-slate-600 leading-relaxed text-sm">
							Segurança em primeiro lugar. Trabalhamos exclusivamente sob a norma NBR 14698, utilizando vidros temperados certificados e ferragens de alta resistência.
						</p>
					</div>
				</div>

				<div class="bg-white border border-slate-100 rounded-2xl p-8 shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-secondary/5 flex flex-col justify-between">
					<div>
						<div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 shadow-sm text-primary">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"/>
								<path d="M12 8c-2 0-3 1-3 3s1 3 3 3 3 1 3 3-1 3-3 3"/>
								<path d="M12 5v14"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-secondary mb-4">Melhor Custo-Benefício</h3>
						<p class="text-slate-600 leading-relaxed text-sm">
							Condições facilitadas de pagamento e parcelamento flexível, garantindo que você tenha o mais alto padrão em vidraçaria com o preço mais justo de POA.
						</p>
					</div>
				</div>

				<div class="bg-white border border-slate-100 rounded-2xl p-8 shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-secondary/5 flex flex-col justify-between">
					<div>
						<div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 shadow-sm text-primary">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 21H3L21 3v18z"/>
								<path d="M18 18H7.5L18 7.5V18z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-secondary mb-4">Projetos Sob Medida</h3>
						<p class="text-slate-600 leading-relaxed text-sm">
							Execução precisa de projetos personalizados, como espelhos com acabamento bisotê, tampos de mesa sob medida e envidraçamentos especiais para sua casa.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 3. Sobre Nós (Resumo) Section -->
	<section class="bg-secondary text-white">
		<div class="container mx-auto px-6 md:px-12">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<div>
					<span class="text-sm font-bold text-primary uppercase tracking-wider mb-3 block">Quem Somos</span>
					<h2 class="text-3xl md:text-4xl font-black text-white tracking-tighter leading-tight mb-6">Tradição e Qualidade na Instalação de Vidros</h2>
					<p class="text-slate-300 text-lg leading-relaxed mb-8">
						Somos uma vidraçaria focada em {SITE_CONFIG.address.city}, especializada no fornecimento e montagem de box de vidro temperado, fechamento de sacadas e espelhos sob medida. Trabalhamos exclusivamente sob as normas técnicas da ABNT para oferecer segurança absoluta e elegância duradoura para o seu imóvel.
					</p>
					<!-- Botão Conheça nossa História com micro-interações -->
					<a href="/sobre" class="inline-block bg-white text-secondary hover:scale-105 active:scale-95 transition-all duration-300 font-extrabold px-8 py-4 rounded-lg shadow-lg shadow-white/5 hover:bg-slate-100">
						Conheça nossa História
					</a>
				</div>
				<div class="bg-white/5 rounded-2xl p-12 flex items-center justify-center min-h-[300px] hover:scale-105 active:scale-95 transition-all duration-300 shadow-sm border border-white/10">
					<div class="text-center">
						<span class="text-6xl font-black text-primary block mb-2">10+</span>
						<p class="text-slate-300 font-bold uppercase tracking-wider">Anos de Experiência no Mercado</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. Nossos Serviços Section -->
	<section id="servicos" class="bg-slate-100/50 border-t border-b border-slate-200/50">
		<div class="container mx-auto px-6 md:px-12">
			<div class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
				<div>
					<h2 class="text-3xl md:text-4xl font-black text-secondary tracking-tighter leading-tight mb-4">Nossos Serviços e Soluções em Vidro</h2>
					<p class="text-lg text-slate-600">Confira a lista dos nossos principais serviços e produtos.</p>
				</div>
			</div>

			<!-- Grade mostrando até 6 serviços da coleção 'servicos', cards com micro-interações e transições -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">
				{services.map((service) => {
					const imageUrl = serviceImages[service.slug] || '/glazier_workshop_bg.jpg';
					return (
						<div class="group bg-white border border-slate-100 rounded-2xl overflow-hidden flex flex-col justify-between shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-secondary/5">
							<div>
								<!-- Imagem do Serviço -->
								<div class="relative h-48 overflow-hidden">
									<img 
										src={imageUrl} 
										alt={service.data.title} 
										class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
										loading="lazy"
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
								</div>
								
								<div class="p-8">
									<h3 class="text-xl font-bold text-secondary mb-4">
										{service.data.title}
									</h3>
									<p class="text-slate-600 leading-relaxed text-sm">
										{service.data.description}
									</p>
								</div>
							</div>
							<div class="px-8 pb-8">
								<a href={`/servicos/${service.slug}`} class="text-primary font-bold hover:text-secondary hover:scale-105 active:scale-95 transition-all duration-300 inline-flex items-center text-sm">
									Saiba Mais <span class="ml-1">&rarr;</span>
								</a>
							</div>
						</div>
					);
				})}
			</div>

			<!-- Botão 'Ver Todos os Serviços' -->
			<div class="text-center">
				<a href="/servicos" class="inline-block bg-primary text-accent hover:scale-105 active:scale-95 transition-all duration-300 font-extrabold px-8 py-4 rounded-lg shadow-lg shadow-primary/10 hover:bg-sky-300">
					Ver Todos os Serviços
				</a>
			</div>
		</div>
	</section>

	<!-- Projetos Realizados Section -->
	<section class="bg-white py-20 md:py-28">
		<div class="container mx-auto px-6 md:px-12">
			<div class="mb-16 text-center max-w-3xl mx-auto">
				<span class="text-sm font-bold text-primary uppercase tracking-wider mb-3 block">Nosso Portfólio</span>
				<h2 class="text-3xl md:text-4xl font-black text-secondary tracking-tighter leading-tight mb-4">
					Projetos Executados na Capital Gaúcha
				</h2>
				<p class="text-slate-600 text-lg">
					Confira fotos reais de alguns dos nossos trabalhos de instalação sob medida executados em residências na capital gaúcha.
				</p>
			</div>

			<!-- Grid de Imagens dos Projetos -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<!-- Projeto 1: Box de Banheiro -->
				<div class="group relative overflow-hidden rounded-2xl border border-slate-100 shadow-sm hover:scale-105 active:scale-95 transition-all duration-500 hover:shadow-xl hover:shadow-secondary/5 aspect-[3/4]">
					<img 
						src="/projeto_box.jpg" 
						alt="Instalação de Box de Vidro Temperado em Porto Alegre" 
						class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
						loading="lazy"
					/>
					<!-- Overlay de informações -->
					<div class="absolute inset-0 bg-gradient-to-t from-secondary via-secondary/40 to-transparent opacity-90 p-6 flex flex-col justify-end">
						<span class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Box de Banheiro</span>
						<h3 class="text-lg font-black text-white leading-tight">Box de Canto Elegance</h3>
						<p class="text-slate-300 text-xs mt-1">Instalado no Moinhos de Vento</p>
					</div>
				</div>

				<!-- Projeto 2: Espelho -->
				<div class="group relative overflow-hidden rounded-2xl border border-slate-100 shadow-sm hover:scale-105 active:scale-95 transition-all duration-500 hover:shadow-xl hover:shadow-secondary/5 aspect-[3/4]">
					<img 
						src="/projeto_espelho.jpg" 
						alt="Instalação de Espelho Lapidado sob Medida" 
						class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
						loading="lazy"
					/>
					<!-- Overlay de informações -->
					<div class="absolute inset-0 bg-gradient-to-t from-secondary via-secondary/40 to-transparent opacity-90 p-6 flex flex-col justify-end">
						<span class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Espelho sob Medida</span>
						<h3 class="text-lg font-black text-white leading-tight">Espelho de Banheiro Lapidado</h3>
						<p class="text-slate-300 text-xs mt-1">Instalado no Petrópolis</p>
					</div>
				</div>

				<!-- Projeto 3: Sacada -->
				<div class="group relative overflow-hidden rounded-2xl border border-slate-100 shadow-sm hover:scale-105 active:scale-95 transition-all duration-500 hover:shadow-xl hover:shadow-secondary/5 aspect-[3/4]">
					<img 
						src="/projeto_sacada.jpg" 
						alt="Envidraçamento de Sacada de Apartamento" 
						class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
						loading="lazy"
					/>
					<!-- Overlay de informações -->
					<div class="absolute inset-0 bg-gradient-to-t from-secondary via-secondary/40 to-transparent opacity-90 p-6 flex flex-col justify-end">
						<span class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Envidraçamento</span>
						<h3 class="text-lg font-black text-white leading-tight">Fechamento de Sacada Retrátil</h3>
						<p class="text-slate-300 text-xs mt-1">Instalado no Auxiliadora</p>
					</div>
				</div>

				<!-- Projeto 4: Guarda-corpo -->
				<div class="group relative overflow-hidden rounded-2xl border border-slate-100 shadow-sm hover:scale-105 active:scale-95 transition-all duration-500 hover:shadow-xl hover:shadow-secondary/5 aspect-[3/4]">
					<img 
						src="/projeto_guarda_corpo.jpg" 
						alt="Guarda-corpo de Vidro Temperado e Aço Inox" 
						class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
						loading="lazy"
					/>
					<!-- Overlay de informações -->
					<div class="absolute inset-0 bg-gradient-to-t from-secondary via-secondary/40 to-transparent opacity-90 p-6 flex flex-col justify-end">
						<span class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Segurança & Design</span>
						<h3 class="text-lg font-black text-white leading-tight">Guarda-corpo de Escada</h3>
						<p class="text-slate-300 text-xs mt-1">Instalado no Menino Deus</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Como Funciona Section -->
	<section class="bg-slate-50 border-t border-b border-slate-200/50 py-20 md:py-28">
		<div class="container mx-auto px-6 md:px-12">
			<div class="mb-16 text-center max-w-3xl mx-auto">
				<span class="text-sm font-bold text-primary uppercase tracking-wider mb-3 block">Passo a Passo</span>
				<h2 class="text-3xl md:text-4xl font-black text-secondary tracking-tighter leading-tight mb-4">
					Como Comprar na nossa Vidracaria e instalar Vidros em Porto alegre
				</h2>
				<p class="text-slate-600 text-lg">
					Do primeiro contato pelo WhatsApp até a instalação final, organizamos tudo para sua total comodidade e segurança.
				</p>
			</div>

			<!-- Grid com 4 passos -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16 relative">
				<!-- Passo 1 -->
				<div class="bg-white border border-slate-200/60 rounded-2xl p-8 shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-secondary/5 relative flex flex-col justify-between group">
					<div>
						<div class="absolute top-4 right-6 text-6xl font-black text-slate-100 group-hover:text-primary/10 transition-colors select-none">01</div>
						<div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 shadow-sm text-primary group-hover:scale-110 transition-transform duration-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-secondary mb-3">Contato & Estimativa</h3>
						<p class="text-slate-600 leading-relaxed text-sm">
							Envie uma mensagem no WhatsApp com as medidas aproximadas e fotos do local. Nós enviamos uma estimativa rápida de preço e tiramos suas dúvidas iniciais.
						</p>
					</div>
				</div>

				<!-- Passo 2 -->
				<div class="bg-white border border-slate-200/60 rounded-2xl p-8 shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-secondary/5 relative flex flex-col justify-between group">
					<div>
						<div class="absolute top-4 right-6 text-6xl font-black text-slate-100 group-hover:text-primary/10 transition-colors select-none">02</div>
						<div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 shadow-sm text-primary group-hover:scale-110 transition-transform duration-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-secondary mb-3">Medição Técnica Grátis</h3>
						<p class="text-slate-600 leading-relaxed text-sm">
							Agendamos uma visita sem compromisso. Nosso profissional vai até você para coletar as medidas exatas, avaliar o caimento e indicar a melhor solução para o seu ambiente.
						</p>
					</div>
				</div>

				<!-- Passo 3 -->
				<div class="bg-white border border-slate-200/60 rounded-2xl p-8 shadow-sm hover:scale-105 active:scale-95 transition-all duration-300 hover:shadow-xl hover:shadow-secondary/5 relative flex flex-col justify-between group">
					<div>
						<div class="absolute top-4 right-6 text-6xl font-black text-slate-100 group-hover:text-primary/10 transition-colors select-none">03</div>
						<div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 shadow-sm text-primary group-hover:scale-110 transition-transform duration-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
