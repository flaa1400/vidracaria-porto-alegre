{slug === 'box-de-vidro-para-banheiro' && (
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class={className}>
		<!-- Shower head spraying water on a glass cabin -->
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 2v4M8 4h8M10 6h4M6 21V9a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12" />
		<path stroke-linecap="round" stroke-linejoin="round" d="M9 10v1m3-1v1m3-1v1m-4 4v1m2-1v1m3-6l-1 5" />
	</svg>
)}

