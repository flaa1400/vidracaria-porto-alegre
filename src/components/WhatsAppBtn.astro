---
import { SITE_CONFIG } from '../data/config';
---

<!-- Botão Flutuante do WhatsApp com Efeito de Pulsação e Label no Hover -->
<div class="fixed bottom-6 right-6 z-[998] flex items-center group">
	<!-- Tooltip / Label que aparece no Hover -->
	<span class="bg-accent text-white font-black text-sm py-2 px-4 rounded-lg mr-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none shadow-xl border border-gray-800">
		Fale Conosco
	</span>

	<!-- Link/Botão do WhatsApp -->
	<a 
		href={`https://wa.me/${SITE_CONFIG.whatsappRaw}?text=Ol%C3%A1%20vim%20do%20site%2C%20Vidros%20Pro%20e%20gostaria%20de%20fazer%20um%20Or%C3%A7amento`} 
		target="_blank" 
		rel="noopener noreferrer" 
		class="relative flex items-center justify-center w-16 h-16 bg-[#25D366] text-white rounded-full shadow-xl shadow-[#25D366]/30 hover:scale-110 active:scale-95 transition-all duration-300 focus:outline-none"
		aria-label="Fale conosco no WhatsApp"
	>
		<!-- Efeito de pulsação suave em segundo plano -->
		<span class="absolute inset-0 rounded-full bg-[#25D366] opacity-60 animate-ping -z-10"></span>
		
		<!-- Ícone do WhatsApp SVG Oficial -->
		<svg class="h-8 w-8 fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
			<path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
		</svg>
	</a>
</div>
